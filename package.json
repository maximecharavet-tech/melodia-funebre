{
  "name": "melodia-funebre",
  "version": "1.0.0",
  "description": "Site Melodia Funèbre — Composition musicale personnalisée par IA pour cérémonies funéraires",
  "author": "Maxime Charavet",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "dev": "npx serve . -l 3000",
    "dev:lan": "node scripts/serve-lan.js",
    "dev:python": "python3 -m http.server 3000",
    "check": "node scripts/check.js",
    "deploy": "npx vercel --prod",
    "dev:full": "npx vercel dev",
    "pages": "node build/build.js",
    "pdf": "node build/pdf.js",
    "pdf:relire": "node scripts/relire-pdf.js",
    "partage": "node build/partage-images.js",
    "video": "node build/video.js",
    "indexnow": "node scripts/indexnow.js",
    "build:wasm": "bash scripts/build-wasm.sh",
    "test:julie": "for t in lib/julie/*.test.cjs; do node --test $t || exit 1; done",
    "test:pro": "node --test tests/pro/*.test.mjs",
    "test:sql": "node scripts/prouver-migrations.mjs",
    "test:e2e": "node tests/e2e/pro.e2e.mjs"
  }
}
