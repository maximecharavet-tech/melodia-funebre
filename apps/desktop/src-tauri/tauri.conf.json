{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Melodia Funèbre Pro",
  "version": "0.1.0",
  "identifier": "fr.melodiafunebre.pro",
  "build": {
    "frontendDist": "https://melodia-funebre.fr/pro"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Melodia Funèbre Pro",
        "width": 1366,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "backgroundColor": "#040407",
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "capabilities": ["console-pro"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "publisher": "Melodia Funèbre",
    "copyright": "© Melodia Funèbre",
    "category": "Business",
    "shortDescription": "La console des agences partenaires",
    "longDescription": "Dossiers, questionnaire, composition, QR codes et pages mémorial — la console des agences partenaires de Melodia Funèbre.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": ""
    }
  },
  "plugins": {}
}
